{% extends "base.html.jinja" %}

{%- block title %}Bounce Animations — move.gl{%- endblock %}

{%- block header %}
<p class="ss-t-overline">Animations</p>
<h1>Bounce Animations</h1>
{%- endblock %}

{%- block content %}

<section class="ss-l-region ss-l-region-md">
    <h2>Bounce Effects</h2>
    <p>Playful bouncing animations with elastic easing.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate_bounce"></div>
            <p>bounce</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_bounce_extended"></div>
            <p>bounce-extended</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_bounce_rotate"></div>
            <p>bounce-rotate</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_bounce_multi"></div>
            <p>bounce-multi</p>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Elastic Effects</h2>
    <p>Elastic bounce effects with spring physics.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate_elastic"></div>
            <p>elastic</p>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Usage</h2>

    <pre class="ss-c-code-block">// SCSS Mixin
        .element {
        @include animate_bounce;
        }

        .element-extended {
        @include animate_bounce_extended;
        }

        // Utility classes
        &lt;div class="animate_bounce"&gt;...&lt;/div&gt;
        &lt;div class="animate_bounce_extended"&gt;...&lt;/div&gt;
        &lt;div class="animate_bounce_rotate"&gt;...&lt;/div&gt;</pre>
</section>

{%- endblock %}
