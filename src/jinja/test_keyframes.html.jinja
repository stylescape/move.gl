<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// Define custom keyframes using the mixin</span>
        @include keyframes('animate_bounce') {
        0% { transform: translateY(0); }
        50% { transform: translateY(-30px); }
        100% { transform: translateY(0); }
        }

        <span class="comment">// Use predefined beat keyframes</span>
        @include keyframes_beat;
        @include keyframes_beat_fade;

        <span class="comment">// Apply animation to an element</span>
        .heartbeat {
        animation: keyframes_beat 1s ease-in-out infinite;
        }

        .pulsing {
        animation: keyframes_beat_fade 1.5s ease infinite;
        }

        <span class="comment">// Custom animation with keyframes</span>
        .bouncing-element {
        animation: animate_bounce 0.6s ease infinite;
        }
    </div>
</section>

