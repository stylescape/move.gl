{# ============================================================= #}
{# BLUR FILTERS #}
{# ============================================================= #}
<section class="ss-l-region ss-l-region-md">
    <h2>Blur Filters</h2>
    <p>CSS blur filter effects at various intensities</p>

    <div class="ss-u-grid ss-u-grid-cols-2 ss-u-grid-cols-md-4 ss-u-grid-cols-lg-6 ss-u-gap-24 ss-u-mb-8">
        <div class="ss-c-panel">
            <div class="demo-stage demo-stage--media">
                <img src="https://picsum.photos/200/150?random=1" alt="Original">
            </div>
            <div class="ss-c-panel__body ss-u-text-center">
                <h4 class="ss-t-small-bold ss-u-m-0">Original</h4>
            </div>
            <div class="ss-c-panel__footer ss-u-break-words">
                <code>No filter applied</code>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="demo-stage demo-stage--media filter--blur-sm">
                <img src="https://picsum.photos/200/150?random=1" alt="blur-sm">
            </div>
            <div class="ss-c-panel__body ss-u-text-center">
                <h4 class="ss-t-small-bold ss-u-m-0">blur-sm (2px)</h4>
            </div>
