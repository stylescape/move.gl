<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// Filter Mixins</span>
        .image-blur {
        @include filter_blur(4px);
        }

        .image-grayscale {
        @include filter_grayscale(100%);
        }

        .image-brightness {
        @include filter_brightness(150%);
        }

        <span class="comment">// Shadow Mixins</span>
        .card {
        @include elevation(3);
        }

        .box {
        @include box_shadow(0, 4px, 8px, 0, rgba(0,0,0, .2));
        }

        <span class="comment">// Opacity Mixin</span>
        .faded {
        @include set_opacity(0.5);
        }

        <span class="comment">// Opacity Transition</span>
        .image {
        @include opacity_transition(0.3s, 0.75);
        }
    </div>
</section>

