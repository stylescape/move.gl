{% extends "base.html.jinja" %}

{%- block title %}Slide Animations — move.gl{%- endblock %}

{%- block header %}
<p class="ss-t-overline">Animations</p>
<h1>Slide Animations</h1>
{%- endblock %}

{%- block content %}

<section class="ss-l-region ss-l-region-md">
    <h2>Slide In</h2>
    <p>Directional sliding entrance animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate_slide_in_up"></div>
            <p>slide-in-up</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_slide_in_down"></div>
            <p>slide-in-down</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_slide_in_left"></div>
            <p>slide-in-left</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_slide_in_right"></div>
            <p>slide-in-right</p>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Slide Out</h2>
    <p>Directional sliding exit animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate_slide_out_up"></div>
            <p>slide-out-up</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_slide_out_down"></div>
            <p>slide-out-down</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_slide_out_left"></div>
            <p>slide-out-left</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_slide_out_right"></div>
            <p>slide-out-right</p>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Usage</h2>

    <pre class="ss-c-code-block">// SCSS Mixin
        .element {
        @include animate_slide_in_up;
        }

        .element-out {
        @include animate_slide_out_down;
        }

        // Utility classes
        &lt;div class="animate_slide_in_up"&gt;...&lt;/div&gt;
        &lt;div class="animate_slide_out_down"&gt;...&lt;/div&gt;</pre>
</section>

{%- endblock %}
