{% extends "base.html.jinja" %}

{%- block title %}Getting Started — move.gl{%- endblock %}

{%- block header %}
<p class="ss-t-overline">Documentation</p>
<h1>Getting Started</h1>
{%- endblock %}

{%- block content %}

<section class="ss-l-region ss-l-region-md">
    <h2>Installation</h2>
    <p>Install move.gl via npm:</p>
    <pre class="ss-c-code-block">npm install move.gl</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Import in SCSS</h2>
    <p>Import move.gl in your main SCSS file:</p>
    <pre class="ss-c-code-block">// Import everything
        @use "move.gl" as *;

        // Or keep everything under a namespace
        @use "move.gl" as move;

        .element {
        @include move.animate_fade_in;
        }</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Basic Usage</h2>
    <p>Use the animation mixins in your styles:</p>
    <pre class="ss-c-code-block">// Fade animations
        .fade-element {
        @include animate_fade_in;
        }

        .fade-out-element {
        @include animate_fade_out($duration: 0.3s);
        }

        // Slide animations
        .slide-up {
        @include animate_slide_in_up($duration: 0.5s, $distance: 20px);
        }

        .slide-down {
        @include animate_slide_in_down;
        }

        // Bounce animations
        .bouncy {
        @include animate_bounce($duration: 1s);
        }

        // Custom timing and delay
        .custom {
        @include animate_fade_in($duration: 0.8s, $timing_function: ease-out);
        @include animate_delay(0.2s);
        }</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Utility Classes</h2>
    <p>Use utility classes directly in your HTML:</p>
    <pre class="ss-c-code-block">&lt;!-- Fade animations --&gt;
        &lt;div class="animate_fade_in"&gt;Fades in&lt;/div&gt;
        &lt;div class="animate_fade_out"&gt;Fades out&lt;/div&gt;

        &lt;!-- Slide animations --&gt;
        &lt;div class="animate_slide_in_up"&gt;Slides up&lt;/div&gt;
        &lt;div class="animate_slide_in_down"&gt;Slides down&lt;/div&gt;
        &lt;div class="animate_slide_in_left"&gt;Slides in from the left&lt;/div&gt;
        &lt;div class="animate_slide_in_right"&gt;Slides in from the right&lt;/div&gt;

        &lt;!-- Bounce animations --&gt;
        &lt;div class="animate_bounce"&gt;Bounces&lt;/div&gt;

        &lt;!-- Zoom animations --&gt;
        &lt;div class="animate_zoom"&gt;Zooms&lt;/div&gt;
        &lt;div class="animate_zoom_fade"&gt;Zooms and fades&lt;/div&gt;

        &lt;!-- Flip animations --&gt;
        &lt;div class="animate_flip_horizontal"&gt;Flips horizontally&lt;/div&gt;
        &lt;div class="animate_flip_vertical"&gt;Flips vertically&lt;/div&gt;</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Animation Delays</h2>
    <p>Add delays to stagger animations:</p>
    <pre class="ss-c-code-block">// Fixed delay
        .delayed {
        @include animate_fade_in;
        @include animate_delay(0.2s);
        }

        // Stagger the first 5 children by 100ms each
        .list &gt; * {
        @include animate_fade_in;
        @include animate_stagger(5, 0.1s);
        }</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Next Steps</h2>
    <ul>
        <li><a href="core-concepts.html">Learn the Core Concepts</a></li>
