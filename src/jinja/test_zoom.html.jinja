{% extends "base.html.jinja" %}

{%- block title %}Zoom Animations — move.gl{%- endblock %}

{%- block header %}
<p class="ss-t-overline">Animations</p>
<h1>Zoom Animations</h1>
{%- endblock %}

{%- block content %}

<section class="ss-l-region ss-l-region-md">
    <h2>Zoom Effects</h2>
    <p>Scale-based zoom animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate_zoom"></div>
            <p>zoom</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_zoom_slow"></div>
            <p>zoom-slow</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_zoom_fast"></div>
            <p>zoom-fast</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate_zoom_fade"></div>
            <p>zoom-fade</p>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Usage</h2>

    <pre class="ss-c-code-block">// SCSS Mixin
        .element {
        @include animate_zoom;
        }

        .element-slow {
        @include animate_zoom_slow;
        }

        // Utility classes
        &lt;div class="animate_zoom"&gt;...&lt;/div&gt;
        &lt;div class="animate_zoom_fast"&gt;...&lt;/div&gt;</pre>
</section>

{%- endblock %}
