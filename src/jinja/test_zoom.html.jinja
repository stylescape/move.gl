{% extends "base.html.jinja" %}

{%- block title %}Zoom Animations — move.gl{%- endblock %}

{%- block header %}
<p class="eyebrow">Animations</p>
<h1>Zoom Animations</h1>
{%- endblock %}

{%- block content %}

<section>
    <h2>Zoom In</h2>
    <p>Scale-based entrance animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-zoom-in-demo" id="zoom-in-demo"></div>
            <p>zoom-in</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-zoom-in-up-demo" id="zoom-in-up-demo"></div>
            <p>zoom-in-up</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-zoom-in-down-demo" id="zoom-in-down-demo"></div>
            <p>zoom-in-down</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayZoomIn()">Replay Animations</button>
</section>

<section>
    <h2>Zoom Out</h2>
    <p>Scale-based exit animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-zoom-out-demo" id="zoom-out-demo"></div>
            <p>zoom-out</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayZoomOut()">Replay Animations</button>
</section>

<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// SCSS Mixin</span>
        .element {
        @include zoom-in;
        }

        .element-out {
        @include zoom-out($duration: 0.3s);
        }

        <span class="comment">// With direction</span>
        .card {
        @include zoom-in-up($scale: 0.9);
        }

        <span class="comment">// Utility classes</span>
        &lt;div class="animate-zoom-in"&gt;...&lt;/div&gt;
        &lt;div class="animate-zoom-out"&gt;...&lt;/div&gt;
    </div>
</section>

<script>
    function replayZoomIn() {
        const demos = document.querySelectorAll('[id^="zoom-in"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight;
            demo.style.animation = null;
        });
    }

    function replayZoomOut() {
        const demos = document.querySelectorAll('[id^="zoom-out"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight;
            demo.style.animation = null;
        });
    }
</script>

{%- endblock %}
