<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// SCSS Mixin Usage</span>
        .loading {
        @include loader_spinner;
        }

        .loading-dots {
        @include loader_dots_pulse($color: #3b82f6);
        }

        .loading-progress {
        @include loader_progress_fill($width: 200px);
        }

        .loading-skeleton {
        @include loader_skeleton_shimmer;
        }

