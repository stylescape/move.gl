<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// SCSS Mixin</span>
        .loading {
        @include loader-spinner;
        }

        .loading-dots {
        @include loader-dots($color: #3b82f6);
        }

        <span class="comment">// HTML Structure for dots</span>
        &lt;div class="loader loader--dots"&gt;
        &lt;span&gt;&lt;/span&gt;
        &lt;span&gt;&lt;/span&gt;
        &lt;span&gt;&lt;/span&gt;
        &lt;/div&gt;

        <span class="comment">// HTML Structure for bars</span>
        &lt;div class="loader loader--bars"&gt;
