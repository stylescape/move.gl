{% extends "base.html.jinja" %}

{%- block title %}Core Concepts — move.gl{%- endblock %}

{%- block header %}
<p class="ss-t-overline">Documentation</p>
<h1>Core Concepts</h1>
{%- endblock %}

{%- block content %}

<section class="ss-l-region ss-l-region-md">
    <h2>Animation Categories</h2>
    <p>move.gl organizes animations into logical categories:</p>

    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Keyframes</h3>
                <p class="ss-t-meta ss-u-mb-0">Pre-defined @keyframes for common animation patterns like fade, slide, bounce,
                    zoom, and flip.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Transitions</h3>
                <p class="ss-t-meta ss-u-mb-0">Smooth property transitions between states with customizable timing functions.
                </p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Transforms</h3>
                <p class="ss-t-meta ss-u-mb-0">2D and 3D transform utilities for rotation, scaling, skewing, and translation.
                </p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Loaders</h3>
                <p class="ss-t-meta ss-u-mb-0">Animated loading indicators including spinners, dots, bars, and pulse effects.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Timing Functions</h2>
    <p>Built-in easing functions for natural motion:</p>

    <pre class="ss-c-code-block">// Standard easings
        $timing-linear: linear;
        $timing-ease-in: ease-in;
        $timing-ease-out: ease-out;
        $timing-ease-in-out: ease-in-out;

        // Custom easing curves
        $easing-smooth: cubic-bezier(0.4, 0, 0.2, 1);
        $easing-snap: cubic-bezier(0.4, 0, 0.6, 1);
        $easing-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
        $easing-elastic: cubic-bezier(0.68, -0.6, 0.32, 1.6);

        // Usage
        .element {
        @include animate_fade_in($timing_function: $easing-bounce);
        }</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Duration Scale</h2>
    <p>Consistent duration values for animations:</p>

    <pre class="ss-c-code-block">// Duration scale (all !default, so you can override them)
        $animate_base_duration_fast: 0.25s; // Quick interactions
        $animate_base_duration_normal: 0.5s; // Deliberate motion
        $animate_base_duration: 1s; // Default
        $animate_base_duration_slow: 2s; // Showcase / ambient</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Accessibility</h2>
    <p>move.gl respects user preferences for reduced motion:</p>

    <pre class="ss-c-code-block">// respects_motion only applies animations when the user has no preference
        .element {
        @include respects_motion {
        @include animate_fade_in;
        }
        }

        // Alternative: prefers_reduced_motion for fallback styles
        .element {
        @include animate_fade_in;

        @include prefers_reduced_motion {
        animation: none;
        opacity: 1;
        }
        }</pre>

    <p>Users with <code>prefers-reduced-motion: reduce</code> set in their system preferences will see static content or
        minimal transitions.</p>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Performance</h2>
    <p>move.gl uses GPU-accelerated properties for smooth 60fps animations:</p>

    <ul>
        <li><strong>transform</strong> — For position, rotation, and scale changes</li>
        <li><strong>opacity</strong> — For visibility transitions</li>
        <li><strong>will-change</strong> — Applied automatically for complex animations</li>
    </ul>

    <pre class="ss-c-code-block">// GPU-accelerated animation
        @keyframes slide-up {
        from {
        transform: translateY(20px); // GPU-accelerated
        opacity: 0; // GPU-accelerated
        }
        to {
        transform: translateY(0);
        opacity: 1;
        }
        }

        // Avoid animating these properties (triggers layout):
        // - width, height
        // - margin, padding
        // - top, left, right, bottom</pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Composing Animations</h2>
    <p>Combine multiple animations for complex effects:</p>

    <pre class="ss-c-code-block">// Combined fade + slide in a single animation
        .card-enter {
        @include animate_slide_fade_in_up($duration: 0.5s);
        }

        // Sequential animations with delays
        .stagger-1 { animation-delay: 0ms; }
        .stagger-2 { animation-delay: 100ms; }
        .stagger-3 { animation-delay: 200ms; }
        .stagger-4 { animation-delay: 300ms; }</pre>
</section>

{%- endblock %}
