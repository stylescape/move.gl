{% extends "base.html.jinja" %}

{%- block title %}Flip Animations — move.gl{%- endblock %}

{%- block header %}
<p class="eyebrow">Animations</p>
<h1>Flip Animations</h1>
{%- endblock %}

{%- block content %}

<section>
    <h2>3D Flip Effects</h2>
    <p>Perspective-based rotation animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-flip-x-demo" id="flip-x-demo"></div>
            <p>flip-x</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-flip-y-demo" id="flip-y-demo"></div>
            <p>flip-y</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayFlip()">Replay Animations</button>
</section>

<section>
    <h2>Continuous Flip</h2>
    <p>Looping flip animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-flip-loop"></div>
            <p>flip (infinite)</p>
        </div>
    </div>
</section>

<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// SCSS Mixin</span>
        .card {
        @include flip-x;
        }

        .card-y {
        @include flip-y($duration: 0.8s);
        }

        <span class="comment">// With perspective</span>
        .container {
        perspective: 1000px;

        .card {
        @include flip-x;
        }
        }

        <span class="comment">// Utility classes</span>
        &lt;div class="animate-flip-x"&gt;...&lt;/div&gt;
        &lt;div class="animate-flip-y"&gt;...&lt;/div&gt;
    </div>
</section>

<script>
    function replayFlip() {
        const demos = document.querySelectorAll('[id^="flip-"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight;
            demo.style.animation = null;
        });
    }
</script>

{%- endblock %}
