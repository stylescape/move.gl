{% extends "base.html.jinja" %}

{%- block title %}Special Effects — move.gl{%- endblock %}

{%- block header %}
<p class="eyebrow">Animations</p>
<h1>Special Effects</h1>
{%- endblock %}

{%- block content %}

<section>
    <h2>Elastic</h2>
    <p>Elastic bounce effects with spring physics.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-elastic-in-demo" id="elastic-in-demo"></div>
            <p>elastic-in</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-elastic-out-demo" id="elastic-out-demo"></div>
            <p>elastic-out</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayElastic()">Replay Animations</button>
</section>

<section>
    <h2>Lightspeed</h2>
    <p>Fast skewed entrance and exit animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-lightspeed-in-demo" id="lightspeed-in-demo"></div>
            <p>lightspeed-in</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-lightspeed-out-demo" id="lightspeed-out-demo"></div>
            <p>lightspeed-out</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayLightspeed()">Replay Animations</button>
</section>

<section>
    <h2>Hinge</h2>
    <p>Door hinge falling effect.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-hinge-demo" id="hinge-demo"></div>
            <p>hinge</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayHinge()">Replay Animation</button>
</section>

<section>
    <h2>Float & Glow</h2>
    <p>Subtle floating and glowing effects.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-float-demo"></div>
            <p>float</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-glow-demo"></div>
            <p>glow</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-ripple-demo"></div>
            <p>ripple</p>
        </div>
    </div>
</section>

<section>
    <h2>Wave & Twist</h2>
    <p>Complex transformation animations.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-wave-demo"></div>
            <p>wave</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-twist-demo"></div>
            <p>twist</p>
        </div>
    </div>
</section>

<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// SCSS Mixin</span>
        .element {
        @include animate_elastic_in;
        }

        .element {
        @include animate_lightspeed_in;
        }

        <span class="comment">// Utility classes</span>
        &lt;div class="animate-elastic-in"&gt;...&lt;/div&gt;
        &lt;div class="animate-lightspeed-in"&gt;...&lt;/div&gt;
        &lt;div class="animate-float"&gt;...&lt;/div&gt;
    </div>
</section>

<script>
    function replayElastic() {
        const demos = document.querySelectorAll('[id^="elastic-"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight;
            demo.style.animation = null;
        });
    }

    function replayLightspeed() {
        const demos = document.querySelectorAll('[id^="lightspeed-"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight;
            demo.style.animation = null;
        });
    }

    function replayHinge() {
        const demo = document.getElementById('hinge-demo');
        demo.style.animation = 'none';
        demo.offsetHeight;
        demo.style.animation = null;
    }
</script>

{%- endblock %}
