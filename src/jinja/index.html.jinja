<!-- Accessibility -->
<section class="ss-l-region ss-l-region-md">
    <h2>Accessibility First</h2>
    <p>move.gl ships mixins for the <code>prefers-reduced-motion</code> media query, so users who prefer reduced
        motion see static or minimal animations instead.</p>

    <pre class="ss-c-code-block">// Global reduced-motion reset (include once at root level)
        @include reduced_motion_global;

        // Or only animate when the user has no motion preference
        .element {
        @include respects_motion {
        @include animate_fade_in;
        }
        }</pre>
</section>

