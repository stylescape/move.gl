<!-- Quick Start -->
<section class="ss-l-region ss-l-region-md">
    <h2>Quick Start</h2>
    <pre class="ss-c-code-block">// Install via npm
        npm install move.gl

        // Import in your SCSS
        @use "move.gl" as *;

        // Use animation mixins
        .element {
        @include animate_fade_in;
        }

        .card {
        @include animate_slide_in_up($duration: 0.5s);
        }

        // Or use utility classes directly
        &lt;div class="animate_fade_in"&gt;...&lt;/div&gt;
        &lt;div class="animate_bounce"&gt;...&lt;/div&gt;</pre>
    <a href="getting-started.html" class="ss-c-button ss-c-button--outline ss-u-mt-4">Full Installation Guide →</a>
</section>

