{# ============================================================================
move.gl | Draggable Demo
============================================================================
Interactive demo for the draggable component
============================================================================ #}
{%- extends "_base.html.jinja" -%}

{%- set title = "Draggable Demo — move.gl" -%}
{%- set description = "Draggable Component Demo — Make any element draggable with mouse and touch support." -%}
{%- set current_demo = "draggable" -%}

{%- block header %}
<header class="ss-u-mb-8">
    <span class="ss-c-badge">TypeScript Component</span>
    <h1>Draggable</h1>
    <p class="ss-t-lead">
        Make any HTML element draggable with full mouse and touch support.
        Perfect for creating interactive interfaces, drag-and-drop features, and movable widgets.
    </p>
</header>
{%- endblock -%}

{%- block content %}
<section class="ss-l-region ss-l-region-md">
    <h2>Interactive Demo</h2>
    <p class="ss-t-meta">Try dragging the boxes around the container. Works with both mouse and touch!</p>

    <div class="drag-container" id="dragContainer">
        <div class="draggable-box" id="box1" style="top: 50px; left: 50px;">Drag Me!</div>
        <div class="draggable-box draggable-box--pink" id="box2" style="top: 50px; right: 50px;">Me Too!</div>
        <div class="draggable-box draggable-box--cyan" id="box3"
            style="bottom: 50px; left: 50%; transform: translateX(-50%); width: 150px; height: 80px;">And Me!</div>
    </div>

    <div class="ss-u-flex ss-u-flex-wrap ss-u-gap-12 ss-u-my-4">
        <button class="ss-c-button ss-c-button--primary" onclick="resetPositions()">Reset Positions</button>
        <button class="ss-c-button ss-c-button--outline" onclick="clearLog()">Clear Log</button>
    </div>

    <div class="ss-c-code-block demo-log" id="logOutput" role="log" aria-label="Drag event log">
        <div>[--:--:--] Drag events will appear here...</div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Features</h2>
    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Mouse Support</h4>
                <p class="ss-t-meta ss-u-mb-0">Full mouse drag support with mousedown, mousemove, and mouseup events.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Touch Support</h4>
                <p class="ss-t-meta ss-u-mb-0">Native touch event handling for mobile devices and tablets.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Boundary Constraints</h4>
                <p class="ss-t-meta ss-u-mb-0">Elements are constrained within their parent container bounds.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Event Callbacks</h4>
                <p class="ss-t-meta ss-u-mb-0">Hook into drag events with onDragStart, onDrag, and onDragEnd callbacks.</p>
            </div>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Usage</h2>

    <h3>Basic Usage</h3>
    <pre class="ss-c-code-block"><code>import { Draggable } from 'move.gl';

// Make an element draggable
const draggable = new Draggable('myElement');

// Clean up when done
draggable.destroy();</code></pre>

    <h3>HTML Structure</h3>
    <pre class="ss-c-code-block"><code>&lt;!-- Parent container defines boundaries --&gt;
&lt;div class="container"&gt;
    &lt;div id="myElement" class="draggable"&gt;
        Drag me!
    &lt;/div&gt;
&lt;/div&gt;</code></pre>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>API Reference</h2>

    <h3>Constructor</h3>
    <pre class="ss-c-code-block"><code>new Draggable(elementId: string)</code></pre>

    <h3>Methods</h3>
    <table class="ss-c-table">
        <tr>
            <th>Method</th>
            <th>Description</th>
        </tr>
        <tr>
            <td><code>destroy()</code></td>
            <td>Removes all event listeners and cleans up the instance</td>
        </tr>
    </table>
</section>

{%- include "partials/_demo_links.html.jinja" %}
{%- endblock -%}
