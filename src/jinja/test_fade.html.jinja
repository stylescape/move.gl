{% extends "base.html.jinja" %}

{%- block title %}Fade Animations — move.gl{%- endblock %}

{%- block header %}
<p class="eyebrow">Animations</p>
<h1>Fade Animations</h1>
{%- endblock %}

{%- block content %}

<section>
    <h2>Fade In</h2>
    <p>Smooth opacity transitions from invisible to visible.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-fade-in-demo" id="fade-in-demo"></div>
            <p>fade-in</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-fade-in-up-demo" id="fade-in-up-demo"></div>
            <p>fade-in-up</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-fade-in-down-demo" id="fade-in-down-demo"></div>
            <p>fade-in-down</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-fade-in-left-demo" id="fade-in-left-demo"></div>
            <p>fade-in-left</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-fade-in-right-demo" id="fade-in-right-demo"></div>
            <p>fade-in-right</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayFadeIn()">Replay Animations</button>
</section>

<section>
    <h2>Fade Out</h2>
    <p>Smooth opacity transitions from visible to invisible.</p>

    <div class="demo-row">
        <div class="demo-item">
            <div class="demo-box animate-fade-out-demo" id="fade-out-demo"></div>
            <p>fade-out</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-fade-out-up-demo" id="fade-out-up-demo"></div>
            <p>fade-out-up</p>
        </div>
        <div class="demo-item">
            <div class="demo-box animate-fade-out-down-demo" id="fade-out-down-demo"></div>
            <p>fade-out-down</p>
        </div>
    </div>

    <button class="btn btn--primary" onclick="replayFadeOut()">Replay Animations</button>
</section>

<section>
    <h2>Usage</h2>

    <div class="code-block"><span class="comment">// SCSS Mixin</span>
        .element {
        @include fade-in;
        }

        .element-up {
        @include fade-in-up($duration: 0.5s, $distance: 20px);
        }

        <span class="comment">// With custom options</span>
        .custom {
        @include fade-in(
        $duration: 0.8s,
        $timing: ease-out,
        $delay: 0.2s
        );
        }

        <span class="comment">// Utility classes</span>
        &lt;div class="animate-fade-in"&gt;...&lt;/div&gt;
        &lt;div class="animate-fade-in-up"&gt;...&lt;/div&gt;
        &lt;div class="animate-fade-in-down"&gt;...&lt;/div&gt;
    </div>
</section>

<script>
    function replayFadeIn() {
        const demos = document.querySelectorAll('[id^="fade-in"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight; // Trigger reflow
            demo.style.animation = null;
        });
    }

    function replayFadeOut() {
        const demos = document.querySelectorAll('[id^="fade-out"]');
        demos.forEach(demo => {
            demo.style.animation = 'none';
            demo.offsetHeight; // Trigger reflow
            demo.style.animation = null;
        });
    }
</script>

{%- endblock %}
