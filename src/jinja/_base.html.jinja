<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    {%- include "partials/_head.html.jinja" %}
    <title>{%- block title %}{{ title | default('move.gl') }}{%- endblock %}</title>

    {%- block head_extra %}
    {%- endblock %}

    {%- block styles %}
    {%- endblock %}
</head>

<body class="{%- block body_class %}{%- endblock %}">
    {%- include "partials/_nav.html.jinja" %}

    <main class="ss-l-container ss-l-region">
        {%- block header %}
        {%- endblock %}

        {%- block content %}
        {%- endblock %}
    </main>

    {%- include "partials/_footer.html.jinja" %}

    <!-- Core Scripts -->
    <script type="module" src="js/demo.js"></script>

    {%- block scripts %}
    {%- endblock %}
</body>

</html>
