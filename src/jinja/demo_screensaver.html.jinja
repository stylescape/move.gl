{# ============================================================================
move.gl | Screensaver Demo
============================================================================
Interactive demo for the screensaver component
============================================================================ #}
{%- extends "_base.html.jinja" -%}

{%- set title = "Screensaver Demo — move.gl" -%}
{%- set description = "Screensaver Demo — Inactivity-based screensaver with video and audio support." -%}
{%- set current_demo = "screensaver" -%}

{%- block header %}
<header class="ss-u-mb-8">
    <span class="ss-c-badge">TypeScript Component</span>
    <h1>Screensaver</h1>
    <p class="ss-t-lead">
        An inactivity-based screensaver system with video and audio support.
        Perfect for kiosk displays, digital signage, and interactive installations.
    </p>
</header>
{%- endblock -%}

{%- block content %}
<section class="ss-l-region ss-l-region-md">
    <h2>Interactive Demo</h2>
    <p class="ss-t-meta">
        The screensaver activates after a period of inactivity. Move your mouse or press any key to reset the timer.
    </p>

    <div class="ss-c-box ss-c-box--bordered">
        <div class="screensaver-preview">
            <div class="preview-placeholder" id="placeholder">
                <div class="icon">▭</div>
                <div>Normal content view</div>
            </div>
            <div class="screensaver-content" id="screensaverContent">
                <div class="icon">☾</div>
                <div class="text">Screensaver Active</div>
                <div class="subtext">Move mouse or press any key to dismiss</div>
            </div>
        </div>

        <div class="ss-c-box ss-c-box--bordered ss-u-flex ss-u-items-center ss-u-justify-between ss-u-mb-4">
            <div class="ss-u-flex ss-u-items-center ss-u-gap-12">
                <div class="status-dot" id="statusDot"></div>
                <span id="statusText">Monitoring activity</span>
            </div>
            <div class="ss-t-text-2xl ss-t-font-bold" id="countdown" aria-label="Time until screensaver">10s</div>
        </div>

        <div class="ss-l-grid ss-l-grid-auto ss-u-mb-4">
            <div class="ss-c-box ss-c-box--bordered">
                <label class="ss-c-section-title ss-u-block" for="timeoutSlider">Timeout (seconds)</label>
                <div class="ss-t-text-2xl ss-t-font-bold" id="timeoutValue">10</div>
                <input type="range" class="ss-c-range ss-u-mt-2" id="timeoutSlider" min="5" max="30" value="10">
            </div>
            <div class="ss-c-box ss-c-box--bordered">
                <label class="ss-c-section-title ss-u-block" for="fadeSlider">Fade Duration (ms)</label>
                <div class="ss-t-text-2xl ss-t-font-bold" id="fadeValue">500</div>
                <input type="range" class="ss-c-range ss-u-mt-2" id="fadeSlider" min="100" max="2000" step="100" value="500">
            </div>
            <div class="ss-c-box ss-c-box--bordered">
                <label class="ss-c-section-title ss-u-block">Activity Events</label>
                <div class="ss-t-text-2xl ss-t-font-bold" id="eventCount">0</div>
            </div>
        </div>

        <div class="ss-u-flex ss-u-flex-wrap ss-u-gap-12 ss-u-my-4">
            <button class="ss-c-button ss-c-button--primary" onclick="forceActivate()">Force Screensaver</button>
            <button class="ss-c-button ss-c-button--danger" onclick="forceDeactivate()">Force Deactivate</button>
            <button class="ss-c-button ss-c-button--outline" onclick="resetDemo()">Reset Demo</button>
        </div>

        <div class="ss-c-code-block demo-log" id="activityLog" role="log" aria-label="Activity log">
            <div>[--:--:--] Demo initialized</div>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Features</h2>
    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Configurable Timeout</h4>
                <p class="ss-t-meta ss-u-mb-0">Set custom inactivity periods before screensaver activation.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Video Support</h4>
                <p class="ss-t-meta ss-u-mb-0">Display videos during screensaver mode with automatic playback.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Audio Support</h4>
                <p class="ss-t-meta ss-u-mb-0">Play audio tracks with volume control during screensaver.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Activity Detection</h4>
                <p class="ss-t-meta ss-u-mb-0">Monitors mouse movement, keyboard input, and touch events.</p>
            </div>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Usage</h2>
    <pre class="ss-c-code-block"><code>import { Screensaver } from 'move.gl';

const screensaver = new Screensaver({
    timeout: 300000,  // 5 minutes
    videoUrl: 'path/to/video.mp4',
    audioUrl: 'path/to/audio.mp3',
    containerId: 'screensaver'
});

screensaver.setVolume(0.5);
screensaver.activate();
screensaver.deactivate();
screensaver.destroy();</code></pre>
</section>

{%- include "partials/_demo_links.html.jinja" %}
{%- endblock -%}
