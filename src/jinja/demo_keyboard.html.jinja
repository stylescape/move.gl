{# ============================================================================
move.gl | Virtual Keyboard Demo
============================================================================
Interactive demo for the virtual keyboard component
============================================================================ #}
{%- extends "_base.html.jinja" -%}

{%- set title = "Virtual Keyboard Demo — move.gl" -%}
{%- set description = "Virtual Keyboard Demo — Customizable on-screen keyboard with multiple layouts." -%}
{%- set current_demo = "keyboard" -%}

{%- block header %}
<header class="ss-u-mb-8">
    <span class="ss-c-badge">TypeScript Component</span>
    <h1>Virtual Keyboard</h1>
    <p class="ss-t-lead">
        A fully customizable on-screen virtual keyboard with support for multiple layouts,
        shift modes, and special character modes. Perfect for kiosks and touch interfaces.
    </p>
</header>
{%- endblock -%}

{%- block content %}
<section class="ss-l-region ss-l-region-md">
    <h2>Interactive Demo</h2>
    <p class="ss-t-meta">Click keys on the virtual keyboard to type. Use mode buttons to switch layouts.</p>

    <div class="ss-c-box ss-c-box--bordered">
        <input type="text" class="ss-c-input ss-u-mb-4" id="keyboardInput" placeholder="Click keys to type..." readonly
            aria-label="Virtual keyboard output">

        <div class="ss-u-flex ss-u-gap-8 ss-u-mb-4" role="group" aria-label="Keyboard layout">
            <button type="button" class="mode-btn ss-c-button ss-c-button--primary ss-c-button--sm" data-mode="default" aria-pressed="true" onclick="switchMode('default')">ABC</button>
            <button type="button" class="mode-btn ss-c-button ss-c-button--outline ss-c-button--sm" data-mode="shift" aria-pressed="false" onclick="switchMode('shift')">⇧ SHIFT</button>
            <button type="button" class="mode-btn ss-c-button ss-c-button--outline ss-c-button--sm" data-mode="special" aria-pressed="false" onclick="switchMode('special')">123</button>
        </div>

        <div class="ss-u-flex ss-u-flex-col ss-u-gap-8 ss-u-mb-4" id="keyboard" role="group" aria-label="Virtual keyboard"></div>

        <div class="ss-u-flex ss-u-flex-wrap ss-u-gap-24 ss-t-meta">
            <div>Characters: <span id="charCount">0</span></div>
            <div>Words: <span id="wordCount">0</span></div>
            <div>Keypresses: <span id="keypressCount">0</span></div>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Features</h2>
    <div class="ss-l-grid ss-l-grid-auto">
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Full Keyboard</h3>
                <p class="ss-t-meta ss-u-mb-0">Complete QWERTY layout with all letters, numbers, and common symbols.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">⇧ Shift Mode</h3>
                <p class="ss-t-meta ss-u-mb-0">Toggle uppercase letters with shift key support.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Special Characters</h3>
                <p class="ss-t-meta ss-u-mb-0">Dedicated mode for numbers and special symbols.</p>
            </div>
        </div>
        <div class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h3 class="ss-t-h6 ss-u-mt-0">Customizable</h3>
                <p class="ss-t-meta ss-u-mb-0">Easily customize layouts, styles, and key mappings.</p>
            </div>
        </div>
    </div>
</section>

<section class="ss-l-region ss-l-region-md">
    <h2>Usage</h2>
    <pre class="ss-c-code-block"><code>import { VirtualKeyboard } from 'move.gl';

const keyboard = new VirtualKeyboard({
    containerId: 'keyboard-container',
    inputId: 'text-input',
    onKeyPress: (key) => console.log(`Key: ${key}`)
});

// Switch keyboard mode
keyboard.switchMode('shift');
keyboard.switchMode('special');
keyboard.switchMode('default');</code></pre>
</section>

{%- include "partials/_demo_links.html.jinja" %}
{%- endblock -%}
