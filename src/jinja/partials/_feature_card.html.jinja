{# ============================================================================
move.gl | Feature Card Partial
============================================================================
Reusable feature card component
============================================================================ #}

{%- macro feature_card(icon, title, description, href=None) -%}
{%- if href %}
<a href="{{ href }}" class="ss-c-panel">
    {%- else %}
    <div class="ss-c-panel">
        {%- endif %}
        <div class="ss-c-panel__body">
            <h3 class="ss-t-h6 ss-u-mt-0">{{ icon }} {{ title }}</h3>
            <p class="ss-t-meta ss-u-mb-0">{{ description }}</p>
        </div>
        {%- if href %}
</a>
{%- else %}
</div>
{%- endif %}
{%- endmacro -%}
