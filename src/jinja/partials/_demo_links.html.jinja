<section class="ss-l-region ss-l-region-md">
    <h2>More TypeScript Demos</h2>
    <div class="ss-l-grid ss-l-grid-auto">
        {%- if current_demo != 'draggable' %}
        <a href="demo_draggable.html" class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Draggable</h4>
                <p class="ss-t-meta ss-u-mb-0">Make any element draggable with mouse and touch support.</p>
            </div>
        </a>
        {%- endif %}
        {%- if current_demo != 'gesture' %}
        <a href="demo_gesture.html" class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Gesture Handler</h4>
                <p class="ss-t-meta ss-u-mb-0">Touch gestures: tap, swipe, pinch, and rotate detection.</p>
            </div>
        </a>
        {%- endif %}
        {%- if current_demo != 'keyboard' %}
        <a href="demo_keyboard.html" class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Virtual Keyboard</h4>
                <p class="ss-t-meta ss-u-mb-0">Customizable on-screen keyboard with multiple layouts.</p>
            </div>
        </a>
        {%- endif %}
        {%- if current_demo != 'screensaver' %}
        <a href="demo_screensaver.html" class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Screensaver</h4>
                <p class="ss-t-meta ss-u-mb-0">Inactivity-based screensaver with video and audio support.</p>
            </div>
        </a>
        {%- endif %}
        {%- if current_demo != 'video_overlay' %}
        <a href="demo_video_overlay.html" class="ss-c-panel">
            <div class="ss-c-panel__body">
                <h4 class="ss-t-h6 ss-u-mt-0">Video Overlay</h4>
                <p class="ss-t-meta ss-u-mb-0">Transparent video overlay with fade effects.</p>
            </div>
        </a>
        {%- endif %}
    </div>
</section>
