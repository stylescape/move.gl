{
    "name": "move.gl",
    "description": "Motion and Animation Library for Stylescape.",
    "version": "0.0.1",
    "config": {
        "version_short": "0.0"
    },
    "keywords": [
        "move.gl",
        "stylescape",
        "animation",
        "motion",
        "sass",
        "css",
        "transitions",
        "keyframes"
    ],
    "homepage": "https://www.move.gl/",
    "author": "Lars van Vianen <lars@vianen.com> (https://www.vianen.com)",
    "contributors": [
        "Scape Agency <info@scape.agency>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/move.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/move.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "src/ts/index.ts",
    "sass": "src/scss/index.scss",
    "module": "dist/js/move.gl.js",
    "style": "dist/css/move.gl.css",
    "scripts": {
        "build": "npx kist --config ./kist.pro.yml",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "hue.gl": "^0.0.36",
        "unit.gl": "^0.3.1"
    },
    "devDependencies": {
        "@types/node": "^25.2.0",
        "kist": "^0.1.58",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.97.3",
        "serve-static": "^1.16.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./scss/index.scss",
            "types": "./ts/index.d.ts",
            "import": "./js/move.gl.js",
            "default": "./js/move.gl.js"
        },
        "./css/move.gl.css": "./css/move.gl.css",
        "./css/move.gl.min.css": "./css/move.gl.min.css"
    },
    "typesVersions": {
        "*": {
            "*": ["./ts/index.d.ts"]
        }
    }
}
