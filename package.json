{
    "name": "move.gl",
    "description": "Motion and Animation Library for Stylescape.",
    "version": "0.1.0",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "move.gl",
        "stylescape",
        "animation",
        "motion",
        "sass",
        "css",
        "transitions",
        "keyframes"
    ],
    "homepage": "https://www.move.gl/",
    "author": "Lars van Vianen <lars@vianen.com> (https://www.vianen.com)",
    "contributors": [
        "Scape Press <info@scape.press>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/move.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/move.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "type": "module",
    "main": "./dist/js/index.cjs",
    "module": "./dist/js/index.mjs",
    "types": "./dist/js/index.d.ts",
    "sass": "src/scss/index.scss",
    "style": "dist/css/move.gl.css",
    "scripts": {
        "prebuild": "node bin/sync-banner-version.mjs",
        "build": "npx kist --config ./kist.yml && npm run build:ts && npm run build:package",
        "build:ts": "tsup && tsc -p tsconfig.build.json",
        "build:package": "node bin/write-dist-package.mjs",
        "build:docs": "npx kist --config ./kist.docs.yml && tsup src/ts/demo.ts --format esm --target es2020 --out-dir dist/js --no-config",
        "build:demo-site": "node bin/build-demo-site.mjs",
        "typecheck": "tsc --noEmit -p .",
        "lint": "eslint .",
        "test": "vitest run",
        "check:package": "node bin/check-package.mjs",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@getkist/action-nunjucks": "^2.0.9",
        "@getkist/action-sass": "^1.0.4",
        "@types/node": "^26.1.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "happy-dom": "^20.14.5",
        "kist": "^0.1.81",
        "micromatch": "^4.0.8",
        "nunjucks": "^3.2.4",
        "sass": "^1.97.3",
        "serve-static": "^2.2.1",
        "stylescape": "^0.5.1",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.2.1",
        "vitest": "^5.0.3"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "types": "./dist/js/index.d.ts",
            "sass": "./src/scss/index.scss",
            "import": "./dist/js/index.mjs",
            "require": "./dist/js/index.cjs"
        },
        "./scss": "./dist/scss/index.scss",
        "./css/move.gl.css": "./dist/css/move.gl.css",
        "./css/move.gl.min.css": "./dist/css/move.gl.min.css"
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/js/index.d.ts"
            ]
        }
    }
}
